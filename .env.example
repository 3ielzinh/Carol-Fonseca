UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Obrigatório para o checkout Mercado Pago. Access Token da conta (produção) em
# https://www.mercadopago.com.br/developers/panel/app. MP_WEBHOOK_SECRET é a
# "Chave secreta" da notificação webhook configurada no mesmo painel; sem ela,
# a assinatura do webhook não é validada (não recomendado em produção).
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Opcional: força a origem usada nos back_urls e no notification_url enviados
# ao Mercado Pago (ex.: https://carolfonseca.com). Sem isso, a origem é
# deduzida do host da própria requisição.
SITE_URL=

# Opcional: encaminha cada lead salvo para CRM, automação ou planilha.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=

# Opcional: alerta técnico (não o CRM) disparado quando o cadastro de leads falha
# em produção (ex.: Redis fora do ar ou variáveis ausentes). Aponte para um webhook
# de monitoramento (Slack Incoming Webhook, Zapier, etc.).
OPS_ALERT_WEBHOOK_URL=
OPS_ALERT_WEBHOOK_SECRET=

# Obrigatório para o painel administrativo (/admin): senha única de acesso e
# segredo usado para assinar o cookie de sessão. Gere valores longos e aleatórios.
ADMIN_PANEL_PASSWORD=
ADMIN_SESSION_SECRET=
